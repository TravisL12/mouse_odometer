{
  "name": "Mouse Odometer",
  "version": "1.1.0",
  "manifest_version": 3,
  "description": "Mouse tracker for your cursor: see how far it travels each day in pixels, miles, or trips to the moon. No data collected.",
  "background": {
    "service_worker": "public/scripts/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "public/scripts/utilities/odometer.min.js",
        "public/scripts/contentScript.js"
      ],
      "css": [
        "public/styles/odometer-theme-default.css",
        "public/styles/content.css"
      ]
    }
  ],
  "action": {
    "default_title": "Mouse Odometer!",
    "default_popup": "options.html",
    "default_icon": "public/images/mouse_icon_white.png"
  },
  "icons": {
    "16": "public/images/mouse_icon_white.png",
    "128": "public/images/mouse_icon_white.png"
  },
  "options_page": "options.html",
  "permissions": ["storage"]
}
